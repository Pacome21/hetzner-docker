# Copy to wg0.conf and set PrivateKey (and adjust peers if needed).
# LinuxServer WireGuard client mode: do not set PEERS in docker-compose.

[Interface]
PrivateKey = YOUR_CLIENT_PRIVATE_KEY
Address = 10.0.1.5/32
DNS = 192.168.1.1

[Peer]
PublicKey = SERVER_PUBLIC_KEY
# Split tunnel: seul le LAN distant via le VPN (ajuster le préfixe si besoin).
AllowedIPs = 192.168.1.0/24
Endpoint = 178.198.57.218:51820
PersistentKeepalive = 25
